{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "akvot://discovery/impl-ready/queryplan/v1",
  "title": "QueryPlan (implementation-readiness design schema)",
  "description": "Design-only. SEARCH INTENT not ENTITY TRUTH. Not runtime-wired.",
  "type": "object",
  "required": [
    "planSchemaVersion",
    "planId",
    "seedClass",
    "orderedIntents",
    "budgets",
    "stopConditions",
    "dedupeRules",
    "provenanceRequirements",
    "reasons",
    "forbiddenDirectives",
    "planInputSnapshotHash",
    "configVersion"
  ],
  "properties": {
    "planSchemaVersion": {
      "type": "string"
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "planInputSnapshotHash": {
      "type": "string",
      "minLength": 1
    },
    "configVersion": {
      "type": "string"
    },
    "sessionId": {
      "type": "string"
    },
    "seedHash": {
      "type": "string"
    },
    "seedClass": {
      "type": "string",
      "enum": [
        "person",
        "company",
        "organization",
        "domain",
        "url",
        "document",
        "ambiguous",
        "unknown"
      ]
    },
    "orderedIntents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiscoveryIntent"
      }
    },
    "budgets": {
      "$ref": "akvot://discovery/impl-ready/budget/v1"
    },
    "stopConditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dedupeRules": {
      "type": "object",
      "required": [
        "titleBridgeForbidden",
        "typedSoftRefAttachOnly"
      ],
      "properties": {
        "byEvidenceFingerprint": {
          "type": "boolean"
        },
        "byCanonicalUrl": {
          "type": "boolean"
        },
        "titleBridgeForbidden": {
          "const": true
        },
        "typedSoftRefAttachOnly": {
          "const": true
        }
      }
    },
    "provenanceRequirements": {
      "type": "object"
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "target",
          "reason"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "forbiddenDirectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "knownRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(qid|viaf|ol):.+"
      }
    },
    "urlTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "safety"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "safety": {
            "enum": [
              "pending",
              "allowed",
              "blocked",
              "unsafe"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "DiscoveryIntent": {
      "type": "object",
      "required": [
        "intentId",
        "priority",
        "sourceFamilies",
        "budgets",
        "reason"
      ],
      "properties": {
        "intentId": {
          "type": "string",
          "enum": [
            "DISCOVER_IDENTITY_REFERENCES",
            "DISCOVER_OFFICIAL_WEB_ORIGIN",
            "DISCOVER_DOCUMENTS",
            "DISCOVER_ORGANIZATION_PRESENCE",
            "DISCOVER_PUBLICATIONS",
            "DISCOVER_NEWS",
            "DISCOVER_FILINGS",
            "DISCOVER_REGISTRIES",
            "DISCOVER_ALIASES",
            "DISCOVER_RELATED_ENTITIES"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "sourceFamilies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "queries": {
          "type": "array"
        },
        "budgets": {
          "type": "object"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": false
}
