{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "akvot://discovery/design/evidence-graph/v1",
  "title": "EvidenceGraph (design contract)",
  "description": "Complement to findings list. Not a dossier. No implicit edges. SAME-ENTITY forbidden under experimental Discovery lanes.",
  "type": "object",
  "required": [
    "graphSchemaVersion",
    "nodes",
    "edges"
  ],
  "properties": {
    "graphSchemaVersion": {
      "type": "string",
      "const": "1.0.0-design"
    },
    "sessionId": {
      "type": "string"
    },
    "planId": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "seed",
              "finding",
              "evidence",
              "reference",
              "url",
              "domain",
              "document",
              "organization",
              "person",
              "source"
            ]
          },
          "attrs": {
            "type": "object"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "from",
          "to",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "supports",
              "derived-from",
              "same-reference",
              "same-entity",
              "related-entity",
              "possible-match",
              "contradicts",
              "unknown"
            ]
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "provenance": {
            "type": "object",
            "required": [
              "signalSummary"
            ],
            "properties": {
              "planId": {
                "type": "string"
              },
              "intentId": {
                "type": "string"
              },
              "familyId": {
                "type": "string"
              },
              "providerId": {
                "type": "string"
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "softRefKeys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "signalSummary": {
                "type": "string",
                "minLength": 1
              },
              "createdAt": {
                "type": "string"
              }
            }
          },
          "attachAllowed": {
            "type": "boolean"
          }
        }
      }
    },
    "implicitEdgesForbidden": {
      "type": "boolean",
      "const": true
    }
  },
  "additionalProperties": false
}
