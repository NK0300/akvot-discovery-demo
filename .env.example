# Local / Preview env template — copy to .env.local (never commit secrets)
# Flags default OFF. Do not enable in production without Chief GO.

# Optional KV (Vercel KV / Upstash) — leave empty for in-memory demo store
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Discovery QueryPlan orchestration (GO-IMPL) — default OFF = B0 verbatim
DISCOVERY_ENABLE_QUERYPLAN=0

# Optional model key for Entity Mode enrich (not required for Discovery fixtures)
# GOOGLE_GENERATIVE_AI_API_KEY=

# URL/domain CANDIDATES surface (provenance + why-found). Default OFF.
DISCOVERY_ENABLE_URL_DOMAIN_CANDIDATES=0

# L1 bridge uses BOTH of these (default OFF): WD P856 officialWebsiteUrls → gated web_origin
# DISCOVERY_WD_CLAIM_PACK=0
# DISCOVERY_ENABLE_WEB_ORIGIN=0

# General web search adapter stub/contract only. Default OFF. No uncontrolled crawl.
DISCOVERY_ENABLE_GENERAL_WEB=0
